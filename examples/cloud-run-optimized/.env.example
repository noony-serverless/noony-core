# ============================================================================
# Cloud Run Optimized Example - Environment Variables
# ============================================================================

# ============================================================================
# Server Configuration
# ============================================================================
PORT=8080
HOST=0.0.0.0
NODE_ENV=production

# ============================================================================
# OpenTelemetry Configuration (Cloud Run Optimized)
# ============================================================================
# Enable OTEL (auto-enabled in production or when K_SERVICE is set)
OTEL_ENABLED=true

# Service name (defaults to K_SERVICE on Cloud Run)
OTEL_SERVICE_NAME=my-api

# Enable OPTIONS request tracing (default: false)
# Set to true if you need to trace CORS preflight requests
OTEL_OPTION_REQ_ENABLE=false

# ============================================================================
# Google Cloud Configuration
# ============================================================================
# Project ID (auto-detected on Cloud Run from K_SERVICE)
GOOGLE_CLOUD_PROJECT=my-project-id

# Cloud Run region (auto-detected from CLOUD_RUN_REGION)
# CLOUD_RUN_REGION=us-central1

# ============================================================================
# Pub/Sub Configuration (for async-processor.ts)
# ============================================================================
# Subscription name for async message processing
SUBSCRIPTION_NAME=order-events-sub

# Topic name for publishing events
PUBSUB_TOPIC=order-events

# ============================================================================
# Database Configuration
# ============================================================================
# MongoDB connection string (auto-traced by OTEL)
# MONGODB_URI=mongodb://mongo-service:27017/mydb

# ============================================================================
# IAM Roles Required on Cloud Run
# ============================================================================
# The Cloud Run service account needs:
# - roles/cloudtrace.agent (write traces to Cloud Trace)
# - roles/logging.logWriter (write logs to Cloud Logging)
# - roles/monitoring.metricWriter (write metrics to Cloud Monitoring)
# - roles/pubsub.subscriber (for async-processor.ts only)
#
# Grant roles using:
# gcloud projects add-iam-policy-binding PROJECT_ID \
#   --member="serviceAccount:SERVICE_ACCOUNT@PROJECT_ID.iam.gserviceaccount.com" \
#   --role="roles/cloudtrace.agent"
