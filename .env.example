# ============================================================================
# Noony Serverless Core - Environment Variables
# ============================================================================

# ============================================================================
# Server Configuration
# ============================================================================
PORT=8080
HOST=0.0.0.0
NODE_ENV=development

# ============================================================================
# OpenTelemetry Configuration (Automatic Tracing & Metrics)
# ============================================================================
# OTEL auto-instruments Fastify, MongoDB, HTTP for traces sent to Cloud Trace
# Metrics are sent to Cloud Monitoring for observability dashboards
#
# Local Development (OTEL_ENABLED=false):
#   ✅ No overhead, faster startup, simpler debugging
#   ✅ Use when developing features locally
#
# Production/Cloud Run (OTEL_ENABLED=true):
#   ✅ Automatic distributed tracing across all endpoints
#   ✅ Performance metrics and SLOs in Cloud Monitoring
#   ✅ Correlated logs with traceId/spanId in Cloud Logging
#   ⚠️  Requires IAM roles: roles/cloudtrace.agent, roles/monitoring.metricWriter
#
# Cloud Run automatically sets K_SERVICE, no need to configure credentials
OTEL_ENABLED=false
OTEL_SERVICE_NAME=noony-api
# OTEL_LOG_LEVEL=info  # Optional: debug, info, warn, error

# Enable tracing for OPTIONS requests (CORS preflight)
# Default: false (reduces noise in traces)
# OTEL_OPTION_REQ_ENABLE=false

# ============================================================================
# Google Cloud Configuration
# ============================================================================
# Project ID (auto-detected on Cloud Run from K_SERVICE)
# GOOGLE_CLOUD_PROJECT=my-project-id
# GCP_PROJECT=my-project-id

# Cloud Run region (auto-detected from CLOUD_RUN_REGION env var)
# CLOUD_RUN_REGION=us-central1

# ============================================================================
# Authentication & Security
# ============================================================================
# JWT secret for token validation (required for AuthenticationMiddleware)
# JWT_SECRET=your-secret-key-here

# CORS origins (comma-separated)
# CORS_ORIGINS=https://example.com,https://app.example.com

# ============================================================================
# Database Configuration
# ============================================================================
# MongoDB connection string (auto-traced when OTEL_ENABLED=true)
# MONGODB_URI=mongodb://localhost:27017/mydb

# Firestore database (auto-detected on Cloud Run)
# FIRESTORE_PROJECT_ID=my-project-id

# ============================================================================
# Pub/Sub Configuration (for async processing)
# ============================================================================
# Pub/Sub topic for async jobs (auto-traced when OTEL_ENABLED=true)
# PUBSUB_TOPIC=order-events
# PUBSUB_SUBSCRIPTION=order-events-sub

# ============================================================================
# Logging Configuration
# ============================================================================
# Log level: debug, info, warn, error
# LOG_LEVEL=info

# Enable debug mode (overrides LOG_LEVEL)
# DEBUG=true

# ============================================================================
# Performance & Monitoring
# ============================================================================
# Enable performance monitoring
# PERFORMANCE_MONITORING_ENABLED=true

# Request timeout in milliseconds
# REQUEST_TIMEOUT_MS=30000
